# ── Server ───────────────────────────────────────────────
PORT=3000

# ── Share links ──────────────────────────────────────────
# /ig  -> opens Instagram DMs with Ankeeta
# /li  -> opens the web chat (put this link on LinkedIn)
# /wa  -> opens the web chat (put this link on WhatsApp)
# Your Instagram username (no @) – /ig opens https://ig.me/m/<username>
INSTAGRAM_USERNAME=your_instagram_username

# ── Instagram Messaging API (Meta Developer App) ─────────
# Any random string you choose; paste the same value in the Meta webhook setup
INSTAGRAM_VERIFY_TOKEN=change-me-to-a-long-random-string
# Long-lived access token for the Instagram professional account
INSTAGRAM_ACCESS_TOKEN=
# App Secret from Meta App Dashboard > App settings > Basic (used to verify X-Hub-Signature-256)
INSTAGRAM_APP_SECRET=
# Optional overrides
# INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
# INSTAGRAM_GRAPH_VERSION=v23.0

# ── WhatsApp Cloud API (same Meta app can be used) ───────
# WhatsApp DMs are OWNER-ONLY. List your own number(s), international format, digits only
# (country code first, no + or spaces). Comma-separate to allow more than one.
WHATSAPP_ALLOWED_NUMBERS=919876543210
# Any random string; paste the same value in the Meta webhook setup for WhatsApp
WHATSAPP_VERIFY_TOKEN=change-me-too
# Permanent (system user) access token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" from WhatsApp > API Setup (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# Optional – defaults to INSTAGRAM_APP_SECRET (use when the WhatsApp app is a different Meta app)
# WHATSAPP_APP_SECRET=

# ── LLM ──────────────────────────────────────────────────
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Optional: "anthropic" (default) or "openai" (any OpenAI-compatible endpoint)
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=20000

# ── LinkedIn draft-reply helper ──────────────────────────
# Protects POST /api/linkedin/draft-reply and the /linkedin page. Leave empty to disable.
# Generate one with:  openssl rand -hex 32
ADMIN_API_KEY=

# ── Opening greeting ─────────────────────────────────────
# Ankeeta's first reply when a brand-new chat starts with just "hi". Empty = disabled.
# GREETING_MESSAGE=Heyy! 😊 I’m Ankeeta, and I’m always up for a good conversation. Tell me how your day is going.

# ── Conversation memory ──────────────────────────────────
# Messages remembered per (platform, user)
HISTORY_LIMIT=15
# SQLite file (use a persistent disk in production)
DATABASE_PATH=./data/ankeeta.db
# If set, Redis is used instead of SQLite
# REDIS_URL=redis://localhost:6379
