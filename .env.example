# ── Server ───────────────────────────────────────────────
PORT=3000

# ── LLM (required) ───────────────────────────────────────
# Anthropic (default):   LLM_PROVIDER=anthropic, LLM_MODEL=claude-haiku-5-5
# Google Gemini (free tier, OpenAI-compatible):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-flash-lite-latest
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# LLM_PROVIDER=anthropic
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=20000

# ── Optional ─────────────────────────────────────────────
# Ankeeta's first reply when a chat starts with just "hi". Empty = disabled.
# GREETING_MESSAGE=Heyy! 😊 I’m Ankeeta, and I’m always up for a good conversation. Tell me how your day is going.

# Messages remembered per visitor
HISTORY_LIMIT=15
# SQLite file (use a persistent disk in production)
DATABASE_PATH=./data/ankeeta.db
# If set, Redis is used instead of SQLite
# REDIS_URL=redis://localhost:6379

# ══ Optional integrations (leave everything below empty for web-chat-only) ══

# ── Instagram DMs (Meta Developer App) ───────────────────
# INSTAGRAM_VERIFY_TOKEN=
# INSTAGRAM_ACCESS_TOKEN=
# INSTAGRAM_APP_SECRET=

# ── WhatsApp DMs, owner-only (WhatsApp Cloud API) ────────
# Only these numbers (country code first, digits only) get answers; everyone else is ignored.
# WHATSAPP_ALLOWED_NUMBERS=919876543210
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=

# ── LinkedIn draft helper (copy/paste workflow) ──────────
# Protects POST /api/linkedin/draft-reply and /linkedin. Leave empty to disable.
# ADMIN_API_KEY=
